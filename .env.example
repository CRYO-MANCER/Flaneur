# Copy to .env for private local use. Leave unused integrations blank.
# VITE_* values are exposed to the browser/WebView and embedded in builds.
# Never publish a build containing private credentials. See README.md.

# Active AI Companion provider: Google AI Studio / Gemini
VITE_GEMINI_API_KEY=

# Spotify catalogue search only; account login/sync is not implemented.
# The current client-side client-credentials flow is for private local use.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=

# Moodboard image search
VITE_UNSPLASH_KEY=
VITE_PEXELS_KEY=

# Unused OpenRouter adapter; not required by the current UI.
VITE_OPENROUTER_API_KEY=
